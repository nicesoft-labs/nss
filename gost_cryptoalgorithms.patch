diff --git a/security/nss/lib/ssl/propenssl.c b/security/nss/lib/ssl/propenssl.c
new file mode 100644
index 0000000..30aae8f
--- /dev/null
+++ b/security/nss/lib/ssl/propenssl.c
@@ -0,0 +1,524 @@
+/* Модуль поддержки провайдера протокола SSL openssl 
+   Copyright 2010 ЗАО "НИП Информзащита" (http://www.infosec.ru/)
+   Авторы: Александр Сапожников (NCR@infosec.ru), Андрей Гаврилин (andrey.gavrilin@trustverse.com)
+*/
+
+#include "cert.h"
+#include "ssl.h"
+#include "sslimpl.h"
+
+#include <pkcs12.h>
+#include <pk11func.h>
+#include <secitem.h>
+#include <private/pprio.h>
+
+#include <openssl/err.h>
+#include <openssl/engine.h>
+#include <openssl/ssl.h>
+#include <openssl/pkcs12.h>
+
+#include <p12.h>
+
+#if defined(WIN32)
+#define MAP_ERROR(from,to) if (err == from) { PORT_SetError(to); }
+#define DEFINE_ERROR       PRErrorCode err = PR_GetError();
+#else
+#define MAP_ERROR(from,to)
+#define DEFINE_ERROR
+#endif
+
+/* Контекст OpenSSL */
+static SSL_CTX *ctx=NULL; 
+
+/* Сохранённая информация о соединении в формате Firefox */
+static sslSocket *_ss=NULL;
+
+/* Вывод в консоль описания ошибки OpenSSL */
+static void SSL_perror(const char *where) {
+    u_long e;
+    int line, flags;
+    const char *file,*data;
+    while ((e=ERR_get_error_line_data(&file,&line,&data,&flags))) {
+	const char *ls=ERR_lib_error_string(e);
+	const char *fs=ERR_func_error_string(e);
+	const char *rs=ERR_reason_error_string(e);
+	printf("OpenSSL: %s: %s: %s: %s (%s:%d) %s", 
+	    where, ls?ls:"unknown", fs?fs:"unknown", rs?rs:"unknown", 
+	    file, line, (flags&ERR_TXT_STRING)?data:"");
+    }
+}
+
+/* Обработчик выходного потока для функции SEC_PKCS12Encode() */
+void BIO_callback(void *arg, const char *buf, unsigned long len) {
+    if (arg && buf && len>0)
+	BIO_write((BIO*)arg, buf, len);
+}
+
+/* Инициализация сертификата пользователя */
+static int ssl_get_peer_certificate(sslSocket *ss) {
+    int rv = 0;
+    if (ss) {
+        if (!ss->sec.peerCert) {
+            /* Получаем из соединения сертификат пользователя */
+            X509 *x509 = SSL_get_peer_certificate((SSL*)(ss->openssl));
+            if (x509) {
+                /* Преобразование сертификата из формата OpenSSL в формат Firefox */
+                unsigned char *pp;
+                SECItem certItem;
+                /* Получаем размер сертификата */
+                certItem.len  = i2d_X509(x509, NULL);
+                if (certItem.len > 0) {
+                    /* Выделяем память под сертификат */
+                    pp = PORT_Alloc(certItem.len);
+                    certItem.data = pp;
+                    /* Записываем сертификат в выделенную память */
+                    if (i2d_X509(x509, &pp) > 0) {
+                        /* Преобразуем сертификат в формат Firefox */
+                        /*ss->sec.peerCert = CERT_NewTempCertificate(ss->dbHandle, certItem, NULL, PR_FALSE, PR_TRUE);*/
+                        ss->sec.peerCert = SEC_PKCS12DecodeDERCertificate(&certItem, PR_TRUE, NULL);
+                        if (ss->sec.peerCert) rv = 1;
+                    }
+                    PORT_Free(pp);
+                }
+                X509_free(x509);
+            }
+        } else {
+            rv = 1;
+        }
+    }
+
+    return rv;
+}
+
+/* Обработчик запроса сертификата пользователя для OpenSSL */
+static int ssl_OpensslGetClientCertificate(
+	SSL *ssl, X509 **pcert, EVP_PKEY **pkey) {
+    int rv=-1;
+
+    SECItem* certDER = NULL;
+    SECItem* keyDER = NULL;
+       
+    *pkey=NULL;
+    *pcert=NULL;
+
+    if (!_ss || !_ss->getClientAuthDERData)
+        return -1;
+
+    /* Получаем из соединения сертификат пользователя */
+    if (!ssl_get_peer_certificate(_ss))
+        return -1;
+
+    CERTDistNames ca_list;
+    PRArenaPool * arena_ca_list = NULL;
+
+    ca_list.arena = NULL;
+    ca_list.nnames = 0;
+    ca_list.names = NULL;
+    ca_list.head = NULL;
+
+    STACK_OF(X509_NAME) *client_CA = SSL_get_client_CA_list(ssl);
+    if ((client_CA != NULL) && (sk_X509_NAME_num(client_CA) > 0)) {
+        int i, count_names = sk_X509_NAME_num(client_CA);
+
+        ca_list.arena = arena_ca_list = PORT_NewArena(DER_DEFAULT_CHUNKSIZE);
+        if (arena_ca_list) {
+            ca_list.nnames = count_names;
+            ca_list.names = PORT_ArenaNewArray(arena_ca_list, SECItem, count_names);
+
+            int success = 1;
+
+            for (i = 0; i < count_names; i++) {
+                X509_NAME *xn = sk_X509_NAME_value(client_CA, i);
+
+                int j, count_entries = sk_X509_NAME_ENTRY_num(xn->entries);
+
+                CERTName name;
+                PRArenaPool *arena_name = name.arena = PORT_NewArena(DER_DEFAULT_CHUNKSIZE);
+                if (!arena_name) {
+                    success = 0;
+                    break;
+                }
+
+                CERTRDN **rdns = (CERTRDN**)PORT_ArenaZAlloc(arena_name, sizeof(CERTRDN*) * (count_entries + 1));
+                if (!rdns) {
+                    success = 0;
+                    break;
+                }
+
+                name.rdns = rdns;
+
+                for (j = 0; j < count_entries; j++) {
+                    X509_NAME_ENTRY *xne=sk_X509_NAME_ENTRY_value(xn->entries, j);
+
+                    CERTRDN *rdn = (CERTRDN*)PORT_ArenaZAlloc(arena_name, sizeof(CERTRDN));
+                    if (!rdn) {
+                        success = 0;
+                        break;
+                    }
+                    *rdns = rdn;
+
+                    CERTAVA **avas = (CERTAVA**)PORT_ArenaZAlloc(arena_name, sizeof(CERTAVA*) << 1);
+                    if (!avas) {
+                        success = 0;
+                        break;
+                    }
+                    rdn->avas = avas;
+
+                    CERTAVA *ava = (CERTAVA*)PORT_ArenaZAlloc(arena_name, sizeof(CERTAVA));
+                    if (!ava) {
+                        success = 0;
+                        break;
+                    }
+                    *avas = ava;
+
+                    ava->type.data = PORT_ArenaZAlloc(arena_name, sizeof(char) * xne->object->length);
+                    if (!ava->type.data) {
+                        success = 0;
+                        break;
+                    }
+                    PORT_Memcpy(ava->type.data, xne->object->data, xne->object->length);
+                    ava->type.type = siBuffer;
+                    ava->type.len = xne->object->length;
+
+                    ava->value.data = PORT_ArenaZAlloc(arena_name, sizeof(char) * xne->value->length + 2);
+                    if (!ava->value.data) {
+                        success = 0;
+                        break;
+                    }
+                    PORT_Memcpy(ava->value.data + 2, xne->value->data, xne->value->length);
+                    ava->value.data[0] = (char)xne->value->type;
+                    ava->value.data[1] = (char)xne->value->length;
+                    ava->value.type = siBuffer;
+                    ava->value.len = xne->value->length + 2;
+
+                    ++avas;
+                    *avas = 0;
+
+                    ++rdns;
+                }
+
+                if (success) {
+                    *rdns = 0;
+
+                    SECItem *derName = SEC_ASN1EncodeItem(arena_ca_list, NULL, &name, CERT_NameTemplate);
+
+                    if (derName) {
+                        ca_list.names[i].data = derName->data;
+                        ca_list.names[i].len = derName->len;
+
+                        PORT_Free(derName);
+                    } else {
+                        success = 0;
+                    }
+                }
+
+                if (arena_name != NULL)
+                    PORT_FreeArena(arena_name, PR_FALSE);
+
+                if (!success) {
+                    ca_list.nnames = 0;
+                    break;
+                }
+            }
+        }
+    }
+
+    /* Выбираем клиентский сертификат из хранилища */
+    int res = 1;
+    if (ca_list.nnames) {
+        res = (*_ss->getClientAuthDERData)(_ss->getClientAuthDERDataArg, _ss->fd,  &ca_list, &certDER, &keyDER);
+    }
+
+    if (arena_ca_list != NULL)
+        PORT_FreeArena(arena_ca_list, PR_FALSE);
+
+    if (res) {
+        /* Сертификат не найден */
+        return 0;
+    }
+
+    if (certDER && keyDER) {
+        *pcert = d2i_X509(NULL, (const unsigned char **)&certDER->data, certDER->len);
+
+        if (*pcert) {
+            int type = OBJ_obj2nid((*pcert)->cert_info->key->algor->algorithm);
+
+            *pkey = d2i_PrivateKey(type, NULL, (const unsigned char **)&keyDER->data, keyDER->len);
+        }
+
+        if (*pcert && *pkey) {
+             rv = 1;
+        }        
+    }
+
+    if (certDER)
+        SECITEM_ZfreeItem(certDER, PR_TRUE);
+    if (keyDER)
+        SECITEM_ZfreeItem(keyDER, PR_TRUE);
+
+    return rv;
+}
+
+/* Выполнение установление защищенного канала SSL (handshake) */
+static int ssl_OpensslHandshake(sslSocket *ss) {
+    int rv;
+
+    _ss=ss;
+    /* OpenSSL уже инициализирован? */
+    if (!ctx) {
+	ENGINE *e;
+	
+	/* Регистрация engine "gost" OpenSSL */
+	SSLeay_add_all_algorithms();
+	ERR_load_crypto_strings();
+	SSL_load_error_strings();
+            
+	ENGINE_load_gost();
+	e=ENGINE_by_id("gost");
+	if (!e || !ENGINE_set_default(e, ENGINE_METHOD_ALL)) {
+        	ENGINE_free(e);
+		PORT_SetError(PR_LOAD_LIBRARY_ERROR);
+		return PR_FAILURE;
+	}
+	ENGINE_free(e);
+	SSL_library_init();
+
+	/* Создаем контекст OpenSSL для методов TLS v1 */                    	                    
+	ctx=SSL_CTX_new(TLSv1_client_method());
+	if (!ctx) {
+	    SSL_perror("SSL_CTX_new");
+	    PORT_SetError(PR_OUT_OF_MEMORY_ERROR);
+	    return PR_FAILURE;
+	}
+	
+	/* Регистрируем обработчик запроса сертификата пользователя */
+        SSL_CTX_set_client_cert_cb(ctx, &ssl_OpensslGetClientCertificate);
+    }
+    
+    /* Информация о SSL соединении OpenSSL уже создана? */
+    if (!(ss->openssl)) {
+	/* Получаем из информации о соединении Firefox дескриптор сокета */
+	int fd=PR_FileDesc2NativeHandle(ss->fd->lower);
+	ss->firstHsDone=0;
+	/* Создаем информвцию о SSL соединении OpenSSL */
+	ss->openssl=SSL_new(ctx);
+	if (!(ss->openssl)) {
+	    SSL_perror("SSL_new");
+	    PORT_SetError(PR_OUT_OF_MEMORY_ERROR);
+	    return PR_FAILURE;
+	}
+
+	/* Связываем информацию о SSL соединении OpenSSL с открытым сокетом */
+	SSL_set_fd((SSL*)(ss->openssl), fd);
+    }
+
+    /* Защищенный канал SSL уже установлен? */
+    if (!ss->firstHsDone) {
+	/* Установление защищенного канала SSL */
+	rv=SSL_connect((SSL*)(ss->openssl));
+        if (rv != 1) {
+	    /*printf("SSL_connect()=%d, errno=%d, SSL_get_error()=%d\n", rv, errno, SSL_get_error((SSL*)(ss->openssl), rv));*/
+	    SSL_perror("SSL_connect");
+	    if (errno==EAGAIN)
+		PORT_SetError(PR_WOULD_BLOCK_ERROR);
+	    else 
+		PORT_SetError(PR_NOT_CONNECTED_ERROR);
+	    return PR_FAILURE;
+	}
+    }
+    
+    /* Получаем из соединения сертификат пользователя */
+    if (ssl_get_peer_certificate(ss)) {
+        ss->firstHsDone=1;
+
+        /* Получаем информацию о параметрах защищенного канала OpenSSL */
+        const SSL_CIPHER *cipher=SSL_get_current_cipher((SSL*)(ss->openssl));
+        if (cipher) {
+            /* Устанавливаем размер ключа шифрования */
+            ss->sec.secretKeyBits=cipher->alg_bits;
+            ss->sec.keyBits=cipher->alg_bits;
+        } else {
+            /* Размер ключа шифрования не известен */
+            ss->sec.secretKeyBits=64;
+            ss->sec.keyBits=64;
+        }
+	
+	/* Запускаем обработчик информирования об установлении
+	   защищенного канала SSL Firefox. Он обновит информацию о соединении */
+	if (ss->handshakeCallback)
+		(ss->handshakeCallback)(ss->fd, ss->handshakeCallbackData);
+
+	/* Запускаем обработчик сертификата сервера */    		
+	if (ss->authCertificate) {
+            if ((*ss->authCertificate)(ss->authCertificateArg, ss->fd, PR_FALSE, PR_FALSE)) {
+                /* Сертификат не прошел проверку */
+                if (ss->handleBadCert)
+                    (*ss->handleBadCert)(ss->badCertArg, ss->fd);
+                return PR_FAILURE;
+            }
+        }
+    }
+    return PR_SUCCESS;
+}
+
+
+/* Обработчик запроса на устанавливление TCP соединения с WEB сервером */
+static int ssl_OpensslConnect(sslSocket *ss, const PRNetAddr *sa) {
+    int rv;
+    
+    ss->firstHsDone=0;
+
+    /* Запускаем обработчик по умолчанию Firefox */
+    rv=ssl_DefConnect(ss, sa);
+    if (rv==PR_SUCCESS)
+	    ss->TCPconnected = 1;
+    /* Сокет в не блокируемом режиме */
+    return rv;
+}
+
+/* Обработчик закрытия защищенного канала */
+static int ssl_OpensslShutdown(sslSocket *ss, int how) {
+    /* Завершаем SSL соединение OpenSSL */
+    if (ss->openssl)
+	SSL_shutdown((SSL*)(ss->openssl));
+
+    ss->shutdownHow |= how;
+
+    /* Запускаем обработчик по умолчанию Firefox */
+    return ssl_DefShutdown(ss, how);
+}
+
+/* Обработчик получения данных из защищенного канала */
+static int ssl_OpensslRecv(sslSocket *ss, 
+	unsigned char *buf, int len, int flags) {
+    int rv;
+
+    /* Данные шифрованные? */
+    if (!ss->opt.useSecurity)
+	/* Не шифрованные: запускаем обработчик по умолчанию Firefox */ 
+    	return ssl_DefRecv(ss, buf, len, flags);
+
+    /* Защищенный канал установлен? */    	
+    if (!(ss->firstHsDone)) {
+	ssl_GetSSL3HandshakeLock(ss);
+	/* Запускаем установку защищенного канала */
+	rv=ssl_OpensslHandshake(ss);	
+	ssl_ReleaseSSL3HandshakeLock(ss);
+	if (rv!=PR_SUCCESS)
+	    return rv;
+	if (!(ss->firstHsDone) || !(ss->openssl)) {
+	    PORT_SetError(PR_NOT_CONNECTED_ERROR);
+	    return PR_FAILURE;
+	}
+    }
+
+    ssl_GetSSL3HandshakeLock(ss);
+    /* Читаем данные из защищенного канала */
+    rv=SSL_read((SSL*)(ss->openssl), buf, len);
+    ssl_ReleaseSSL3HandshakeLock(ss);
+    /*if (rv>0) dump("SSL_read", buf, rv);*/
+    if (rv < 0) {
+	/*printf("SSL_read()=%d vs %d errno=%d\n", rv, len, errno);*/
+	SSL_perror("SSL_read");
+	if (errno==EAGAIN)
+	    PORT_SetError(PR_WOULD_BLOCK_ERROR);
+	else 
+	    PORT_SetError(PR_CONNECT_RESET_ERROR);
+	rv = PR_FAILURE;
+    } else if (rv > len) {
+	PORT_Assert(rv <= len);
+	PORT_SetError(PR_BUFFER_OVERFLOW_ERROR);
+	rv = SECFailure;
+    }
+    return rv;
+}
+
+/* Обработчик передачи данных через защищенный канал */
+static int ssl_OpensslSend(sslSocket *ss, 
+	const unsigned char *buf, int len, int flags) {
+    int rv;
+    int sent = 0;
+
+    /* Данные шифрованные? */
+    if (!ss->opt.useSecurity) 
+	/* Не шифрованные: запускаем обработчик по умолчанию Firefox */ 
+    	return ssl_DefSend(ss, buf, len, flags);
+    	
+    /* Защищенный канал установлен? */
+    if (!(ss->firstHsDone)) {
+	ssl_GetSSL3HandshakeLock(ss);
+	/* Запускаем установку защищенного канала */
+        rv=ssl_OpensslHandshake(ss);
+	ssl_ReleaseSSL3HandshakeLock(ss);
+	if (rv!=PR_SUCCESS)
+	    return rv;
+    }
+    
+    do {
+	if (!(ss->firstHsDone) || !(ss->openssl)) {
+	    PORT_SetError(PR_NOT_CONNECTED_ERROR);
+	    return PR_FAILURE;
+	}
+	ssl_GetSSL3HandshakeLock(ss);
+	/* Отправка данных через защищенный канал */
+	rv=SSL_write((SSL*)(ss->openssl), buf, len);
+	ssl_ReleaseSSL3HandshakeLock(ss);
+	if (rv < 0) {
+	    /*printf("SSL_write()=%d vs %d errno=%d\n", rv, len, errno);*/
+	    SSL_perror("SSL_write");
+	    if (errno==EAGAIN) {
+		ss->lastWriteBlocked = 1;
+		return sent ? sent : SECFailure;
+	    }
+	    ss->lastWriteBlocked = 0;
+	    PORT_SetError(PR_CONNECT_RESET_ERROR);
+    	    return PR_FAILURE;
+	}
+	sent += rv;
+    } while (len > sent);
+    ss->lastWriteBlocked = 0;
+    return sent;
+}
+
+/* Обработчик чтения из защищенного канала */
+static int ssl_OpensslRead(sslSocket *ss, unsigned char *buf, int len) {
+    /* Запускаем получение данных из защищенного канала */
+    return ssl_OpensslRecv(ss, buf, len, 0);
+}
+
+/* Обработчик записи в защищенный канал */
+static int ssl_OpensslWrite(sslSocket *ss, const unsigned char *buf, int len) {
+    /* Запускаем передачу данных в защищенный канал */
+    return ssl_OpensslSend(ss, buf, len, 0);
+}
+
+/* Обработчик закрытия TCP соединения с WEB сервером */
+static int ssl_OpensslClose(sslSocket *ss) {
+    ss->firstHsDone=0;
+    if (ss->openssl) {
+	ssl_GetSSL3HandshakeLock(ss);
+	/* Освобождаем информацию о SSL соединении OpenSSL */
+	SSL_free((SSL*)(ss->openssl));
+	ss->openssl=NULL;
+	ssl_ReleaseSSL3HandshakeLock(ss);
+    }
+
+    /* Запускаем обработчик по умолчанию Firefox */
+    return ssl_DefClose(ss);
+}
+
+/* Структура обработчиков вызовов провадера SSL протокола Firefox */
+const sslSocketOps ssl_openssl_ops = {
+    ssl_OpensslConnect,
+    NULL/*ssl_OpensslAccept*/,
+    ssl_DefBind,
+    ssl_DefListen,
+    ssl_OpensslShutdown,
+    ssl_OpensslClose,
+    ssl_OpensslRecv,
+    ssl_OpensslSend,
+    ssl_OpensslRead,
+    ssl_OpensslWrite,
+    ssl_DefGetpeername,
+    ssl_DefGetsockname
+};
