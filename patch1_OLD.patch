+/*! For uniformity, entities in GOST_R3410EL_VerifyDigest are named like those
+    in ECDSA_VerifyDigest. I.e. according X9.62, not GOST R 34.10-2001.
+    The goal is to keep source code of both procedures as close as possible.
+ */
+SECStatus
+GOST_R3410EL_VerifyDigest(const GOSTPublicKey *key, const SECItem *signature,
+                 const SECItem *digest)
+{
+    SECStatus rv = SECFailure;
+#ifndef NSS_ENABLE_ECC
+    PORT_SetError(SEC_ERROR_UNSUPPORTED_KEYALG);
+#else
+    mp_int r_, s_;           /* tuple (r', s') is received signature) */
+    mp_int n;
+    mp_int t, v, z;          /* intermediate values used in verification */
+    mp_err err = MP_OKAY;
+    const ECParams *ecParams = NULL;
+    SECItem pointC = { siBuffer, NULL, 0 };
+    int slen;       /* length in bytes of a half signature (r or s) */
+    int flen;       /* length in bytes of the field size */
+    unsigned olen;  /* length in bytes of the base point order */
+
+    /* Initialize MPI integers. */
+    /* must happen before the first potential call to cleanup */
+    MP_DIGITS(&r_) = 0;
+    MP_DIGITS(&s_) = 0;
+    MP_DIGITS(&n)  = 0;
+    MP_DIGITS(&t)  = 0;
+    MP_DIGITS(&v)  = 0;
+    MP_DIGITS(&z)  = 0;
+
+    if (!key || !signature || !digest) {
+	PORT_SetError(SEC_ERROR_INVALID_ARGS);
+	goto cleanup;
+    }
+
+    ecParams = &(key->ecParams);
+    flen = BITLEN_TO_OCTETLEN( ecParams->fieldID.size );
+    olen = ecParams->order.len;
+    if (signature->len == 0 || signature->len%2 != 0 ||
+	signature->len > 2*olen) {
+	PORT_SetError(SEC_ERROR_INPUT_LEN);
+	goto cleanup;
+    }
+    slen = signature->len/2;
+
+    if( NULL == SECITEM_AllocItem(NULL, &pointC, 2*flen + 1) )
+	goto cleanup; /* error set by SECITEM_AllocItem */
+
+    CHECK_MPI_OK( mp_init(&r_) );
+    CHECK_MPI_OK( mp_init(&s_) );
+    CHECK_MPI_OK( mp_init(&n)  );
+    CHECK_MPI_OK( mp_init(&t)  );
+    CHECK_MPI_OK( mp_init(&v)  );
+    CHECK_MPI_OK( mp_init(&z)  );
+
+    /*  Convert received signature (r', s') into MPI integers.
+        (RFC4491, Section 2.2.1, page 4)
+    */
+    CHECK_MPI_OK( mp_read_unsigned_octets(&s_, signature->data, slen) );
+    CHECK_MPI_OK( mp_read_unsigned_octets(&r_, signature->data + slen, slen) );
+
+    /* GOST R 34.10-2001, Section 6.2, Step 1
+        vrfy: 0 < r' < n,  0 < s' < n
+    */
+    SECITEM_TO_MPINT(ecParams->order, &n);
+    if( mp_cmp_z(&r_) <= 0 || mp_cmp_z(&s_) <= 0 ||
+        mp_cmp(&r_, &n) >= 0 || mp_cmp(&s_, &n) >= 0) {
+	PORT_SetError(SEC_ERROR_BAD_SIGNATURE);
+	goto cleanup; /* will return rv == SECFailure */
+    }
+    /* GOST R 34.10-2001, Section 6.2, Step 3
+        e = HASH(M') mod n; e = 1 if e = 0;
+    */
+    SECITEM_TO_MPINT( *digest, &v ); /* v = HASH(M') */
+    CHECK_MPI_OK( mp_mod(&v, &n, &t ) );
+    if( mp_cmp_z( &t ) == 0 ) {
+        CHECK_MPI_OK( mp_set_int( &t, 1 ) );
+    }
+    /* GOST R 34.10-2001, Section 6.2, Step 4
+        v = e**-1 mod n
+    */
+    CHECK_MPI_OK( mp_invmod(&t, &n, &v) );
+
+    /* GOST R 34.10-2001, Section 6.2, Step 5
+        z1 = s'*v mod n; z2 = -r'*v mod n
+    */
+    CHECK_MPI_OK( mp_mulmod(&r_, &v, &n, &t ) ); /* r'*v mod n */
+    CHECK_MPI_OK( mp_neg( &t, &t ) );            /* - (r'*v mod n)*/
+    CHECK_MPI_OK( mp_mod( &t, &n, &z ) );        /* (-r'*v) mod n */
+    CHECK_MPI_OK( mp_mulmod(&s_, &v, &n, &t ) ); /* s'*v mod n */
+    
+    /* GOST R 34.10-2001, Section 6.2, Step 6
+        C = z1*G + z2*Q; R = Xc mod n
+    */
+    if( SECSuccess != ec_points_mul( ecParams, &t, &z, &key->value, &pointC ))
+        goto cleanup; /* error set by ec_points_mul */
+    CHECK_MPI_OK( mp_read_unsigned_octets( &t, pointC.data + 1, flen) );
+    CHECK_MPI_OK( mp_mod( &t, &n, &z ) ); /* R <- Xc mod n */
+
+    /* GOST R 34.10-2001, Section 6.2, Step 7
+        vrfy: R == r'
+    */
+    if( mp_cmp( &z, &r_ ) != 0 ) {
+	PORT_SetError(SEC_ERROR_BAD_SIGNATURE);
+        goto cleanup;
+    }
+
+    rv = SECSuccess; /* Signature verified. */
+cleanup:
+    mp_clear(&r_);
+    mp_clear(&s_);
+    mp_clear(&n);
+    mp_clear(&t);
+    mp_clear(&v);
+    mp_clear(&z);
+
+    if (pointC.data) SECITEM_FreeItem(&pointC, PR_FALSE);
+    if (err) {
+	MP_TO_SEC_ERROR(err);
+	rv = SECFailure;
+    }
+
+#endif /* NSS_ENABLE_ECC */
+    return rv;
+}
