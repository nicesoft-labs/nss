+/* $Id$ */
+/* \file
+    GOST R 34.11-94 hash step function.
+
+    Depends only from NSPR. Do not include NSS headers.
+ */
+
+#include <prtypes.h>
+#include "gost28147-priv.h"
+#include "gost3411.h"
+#include <string.h> /* for memcmp() */
+
+/*! \define PR_UINT64 Portable construction of UINT64 literals.
+    \details Current NSPR v.4.8 has no macros PR_UINT64 or LL_UINIT. 
+        Let synthesize PR_UINT64.
+        Platform detection code is taken from current prtypes.h, prlong.h.
+*/
+#if defined(HAVE_LONG_LONG) && !defined(PR_UINT64)
+#  if PR_BYTES_PER_LONG == 8 && !defined(__APPLE__)
+#    define PR_UINT64(x) x ## UL
+#  elif defined(WIN32) && !defined(__GNUC__)
+#    define PR_UINT64(x) x ## ui64
+#  else
+#    define PR_UINT64(x) x ## ULL
+#  endif
+#endif /* HAVE_LONG_LONG w/o PR_UINT64 */
+
+/*! \define UNALIGNED_INT_ACCESS Hardware allows access to unaligned integers.
+
+    Intel x86 supports unaligned access. Chk x86 :
+        -- myself for compilers : gcc, sun, microsoft.
+        -- from macro NSS_X86_OR_X64, defined in NSS makefiles
+    If other archs support unaligned access, they can be added here as well.
+    Package maintainers can also define UNALIGNED_INT_ACCESS externally.
+*/
+#ifndef UNALIGNED_INT_ACCESS
+#  if defined(NSS_X86_OR_X64) \
+   || ( (defined(__GNUC__) || defined(__SUNPRO_C)) && \
+            (defined(__i386) || defined(__x86_64) || defined(__amd64)) ) \
+   || ( defined(_MSC_VER) && (defined(_M_IX86) || defined(_M_AMD64) ))
+#  define UNALIGNED_INT_ACCESS
+#  endif
+#endif /* !UNALIGNED_INT_ACCESS */
+
+/*! \define LTOH_DIR direction from least to most significant byte/int. */
+/*! \define LTOH_INC advance ptr to most significant byte direction. */
+/*! \define LTOH_DEC advance ptr to least significant byte direction. */
+/*! \define I256_VINT_IDX position of constituting VInt in array. */
+
+#ifdef IS_LITTLE_ENDIAN
+#  define LTOH_DIR 1
+#  define LTOH_INC( ptr ) (++(ptr))
+#  define LTOH_DEC( ptr ) (--(ptr))
+#  define I256_VINT_IDX( n ) (n)
+#else
+#  define LTOH_DIR (-1)
+#  define LTOH_INC( ptr ) (--(ptr))
+#  define LTOH_DEC( ptr ) (++(ptr))
+#  define I256_VINT_IDX( n ) (I256_NELEM - 1 - (n))
+#endif
+
+/*! Key generation constant C3 [GOST R 34.11-94, section 5.1]
+*/
+static const I256 GenKeys_C3 =
+{
+#ifdef HAVE_LONG_LONG
+#  ifdef IS_LITTLE_ENDIAN
+    PR_UINT64(0xff00ff00ff00ff00), PR_UINT64(0x00ff00ff00ff00ff),
+    PR_UINT64(0xff0000ff00ffff00), PR_UINT64(0xff00ffff000000ff)
+#  else
+    PR_UINT64(0xff00ffff000000ff), PR_UINT64(0xff0000ff00ffff00),
+    PR_UINT64(0x00ff00ff00ff00ff), PR_UINT64(0xff00ff00ff00ff00)
+#  endif
+#else   /* 32-bit ints */
+#  ifdef IS_LITTLE_ENDIAN
+    PR_UINT32(0xff00ff00), PR_UINT32(0xff00ff00), PR_UINT32(0x00ff00ff),
+    PR_UINT32(0x00ff00ff), PR_UINT32(0x00ffff00), PR_UINT32(0xff0000ff),
+    PR_UINT32(0x000000ff), PR_UINT32(0xff00ffff)
+#  else
+    PR_UINT32(0xff00ffff), PR_UINT32(0x000000ff), PR_UINT32(0xff0000ff),
+    PR_UINT32(0x00ffff00), PR_UINT32(0x00ff00ff), PR_UINT32(0x00ff00ff),
+    PR_UINT32(0xff00ff00), PR_UINT32(0xff00ff00)
+#  endif
+#endif  /* 32-bit ints */
+};
+
+/*! "A" transform (inplace) [GOST R 34.11-94, section 5.1]
+    \return v
+ */
+static VInt *
+A( I256 v ) {
+    I64 t;
+    int j, k;
+#ifdef IS_LITTLE_ENDIAN
+    /* t <- x1 */
+    for( j = 0; j < I64_NELEM; ++j )
+        t[j] = v[j];
+    /* v (x4|x3|x2|x1) >> 64 */
+    for( j = I64_NELEM, k = 0; j < I256_NELEM; ++ j, ++k )
+        v[k] = v[j];
+    /* x4 <- x1 ^ x2 */
+    for( j = 0, k = I256_NELEM - I64_NELEM; j < I64_NELEM; ++j, ++k )
+        v[k] = v[j] ^ t[j];
+#else /* BE */
+    for( j = I256_NELEM - I64_NELEM, k = 0; j < I256_NELEM; ++j, ++k )
+        t[k] = v[j];
+    for( j = I256_NELEM - I64_NELEM - 1, k = I256_NELEM - 1; j >= 0; --j, --k )
+        v[k] = v[j];
+    for( j = I256_NELEM - I64_NELEM, k = 0; j < I256_NELEM; ++j, ++ k )
+        v[k] = v[j] ^ t[k];
+#endif
+    return v;
+} /* A */
+
+/*! "P" transform [GOST R 34.11-94, section 5.1]
+    \details dst must not be src
+*/
+static void
+P( I256 dst, const I256 src ) {
+    /*  Transform is symmetric to the I256 BE/LE arrangement.
+     */
+    PRUint8 *s = (PRUint8 *)src, *p,
+            *d = (PRUint8 *)dst;
+    int i, k;
+
+    for( k = 0; k < 4; ++ k ) {
+        p = d++;
+        for( i = 0; i < 8; ++ i ) {
+            *p = *s++; p += 4;
+        }
+    }
+} /* P */
+
+/*! dst = 0
+ */
+static void
+I256_zero( I256 dst ) {
+    int j;
+    for( j = 0; j < I256_NELEM; ++ j )
+        *dst++ = 0;
+}
+
+/*! Load I256 from 256-bit little-endian integer.
+    \param v Buffer with 256-bit little-endian integer. There is no guarantee
+        about buffer aligning.
+    \details compiles in 6 versions: {BE,LE align,LE unalign}*{64|32 bit ints}
+    \return dst
+ */
+static VInt *
+I256_loadLeBytes( I256 dst, const void * m )
+{
+    VInt       *d_p   = dst + I256_VINT_IDX(0);               /* LS int */
+    const VInt *d_end = dst + I256_VINT_IDX(I256_NELEM - 1);  /* MS int */
+
+    /* LE with unaligned access: dereference v directly: *(VInt *)v */
+#ifdef UNALIGNED_INT_ACCESS
+    const VInt *v_p = (const VInt *)m;
+#else  /* LE with aligned integers or BE */
+    const unsigned char *b_p = (const unsigned char *)m;
+#endif
+
+    for(;;) {
+        *d_p =
+#ifdef UNALIGNED_INT_ACCESS
+            *v_p++;
+#else  /* LE with aligned integers or BE */
+            ((VInt)*b_p)          | ((VInt)b_p[1] << 8 )
+          | ((VInt)b_p[2] << 16 ) | ((VInt)b_p[3] << 24)
+#ifdef HAVE_LONG_LONG
+          | ((VInt)b_p[4] << 32 ) | ((VInt)b_p[5] << 40)
+          | ((VInt)b_p[6] << 48 ) | ((VInt)b_p[7] << 56)
+#endif
+        ; /* end of *d_p = */
+        b_p += sizeof(VInt);
+#endif /* LE/aligned or BE */
+
+        if( d_p == d_end ) /* d_p shall not go above dst[0] */
+            break;
+        LTOH_INC(d_p);
+    } /* more signif. int in dst */
+
+    return dst;
+} /* I256_loadLeBytes */
+
+/*! Store I256 into buffer, most significant byte first (BE byte order).
+    This is how NSS expects hash value to be returned.
+*/
+static void
+I256_storBeBytes( void *m, const I256 v )
+{
+    const VInt * v_p   = v + I256_VINT_IDX(I256_NELEM - 1), /* MS int */
+               * v_end = v + I256_VINT_IDX(0);              /* LS int */
+
+    unsigned char *b_p = (unsigned char *)m;
+    VInt t;
+
+    for(;;) {
+        t = *v_p;
+#ifdef HAVE_LONG_LONG
+        *b_p++ = (unsigned char)(t >> 56);
+        *b_p++ = (unsigned char)(t >> 48);
+        *b_p++ = (unsigned char)(t >> 40);
+        *b_p++ = (unsigned char)(t >> 32);
+#endif
+        *b_p++ = (unsigned char)(t >> 24);
+        *b_p++ = (unsigned char)(t >> 16);
+        *b_p++ = (unsigned char)(t >>  8);
+        *b_p++ = (unsigned char)(t      );
+        if( v_p == v_end ) /* v_p shall not go above v[0] */
+            break;
+        LTOH_DEC(v_p);
+    }
+}
+
+static void
+I256_assign( I256 dst, const I256 src ) {
+    int j;
+    for( j = 0; j < I256_NELEM; ++ j )
+        *dst++ = *src++;
+}
+
+/*! dst = v1 ^ v2.
+    \details dst may be the same with v1 or v2.
+    \return dst
+ */
+static VInt *
+I256_xor( I256 dst, const I256 v1, const I256 v2 ) {
+    VInt *d = dst;
+    int j;
+    for( j = 0; j < I256_NELEM; ++ j )
+        *d++ = *v1++ ^ *v2++;
+    return dst;
+}
+
+/*! Generate keys [GOST R 34.11-94, section 5.1]
+ */
+static void
+GenKeys( I256 k[], const I256 h, const I256 m ) {
+    I256 u, v, w;
+    int j;
+
+    I256_assign( u, h );
+    I256_assign( v, m );
+
+    for( j = 0;; ++ j ) {
+        I256_xor( w, u, v ); P( k[j], w ); /* Kj assigned */
+        if( j == 3 )
+            break;
+        A(A(v));
+        A(u);
+        if( j == 1 )
+            I256_xor( u, u, GenKeys_C3 );
+    } /* next Kj */
+}
+
+/*! ψ (psi) transform (inplace) [GOST R 34.11-94, section 5.3]
+    \param order How many times apply ψ transform to I256
+    \return Input I256
+ */
+static VInt *
+psi( I256 v, unsigned order ) {
+    VInt lo, hi;       /* low, high VInt's */
+#ifndef HAVE_LONG_LONG /* 32-bit ints */
+    VInt l2, h2;       /* neighbours of lo, hi */
+#endif
+    PRUint16    t;
+    int         j;
+
+    for( ; order != 0; -- order )
+    {
+        /* t <-  highest 16 bit of result */
+        lo = v[ I256_VINT_IDX(0) ];
+        hi = v[ I256_VINT_IDX(I256_NELEM - 1) ];
+#ifndef HAVE_LONG_LONG /* 32-bit ints */
+        l2 = v[ I256_VINT_IDX(1) ];
+        h2 = v[ I256_VINT_IDX(I256_NELEM - 2) ];
+#endif
+        t = (PRUint16)( lo ^ (lo >> 16) ^
+#ifdef HAVE_LONG_LONG /* 64-bit ints */
+            (lo >> 32) ^ (lo >> 48) ^ hi ^ (hi >> 48));
+#else   /* 32-bit ints */
+            l2 ^ (l2 >> 16) ^ h2 ^ (hi >> 16));
+#endif
+        /* v <-  t ||| v >> 16 */
+        for( j = I256_VINT_IDX(I256_NELEM - 1);
+            j != (I256_VINT_IDX(0) - LTOH_DIR); LTOH_DEC(j) )
+        {
+            v[j] = ((lo = v[j]) >> 16) | ((VInt)t << (BITS_PER_VINT - 16));
+            t = (PRUint16)lo;
+        }
+    } /* next Ksi */
+    return v;
+}
+
+/*! sum += item mod 2**256
+    \sa I256_add8n
+ */
+static void
+I256_add( I256 sum, const I256 item )
+{
+    const VInt  *i_p   = item + I256_VINT_IDX(0);
+    VInt        *s_p   =  sum + I256_VINT_IDX(0),
+                *s_end =  sum + I256_VINT_IDX(I256_NELEM - 1);
+
+    VInt x, y, s; /* item, item, temp sum */
+    int c = 0;    /* carry */
+
+    for(;;) {
+        *s_p = s = (x = *s_p) + (y = *i_p) + c;
+        if( s_p == s_end ) /* X_p shall not go above array[0] */
+            break;
+        /*  calc. carry (overflow detection). See section 2.15 in:
+            Warren H.S. Hacker's Delight. - Addison-Wesley, 2002
+         */
+        c = (( x & y ) | ( (x | y) & ~s )) >> (BITS_PER_VINT-1);
+        LTOH_INC(s_p);
+        LTOH_INC(i_p);
+    }
+}
+
+/*! sum += 8*n mod 2**256
+    \details If 'n' is number of bytes, this results in adding number of bits.
+    \sa I256_add
+ */
+static void
+I256_add8n( I256 sum, VInt n )
+{
+    VInt *s_p   = sum + I256_VINT_IDX(0),
+         *s_end = sum + I256_VINT_IDX(I256_NELEM - 1);
+
+    /* (8*n) is (n << 3): spread over two VInt's.
+       adding lowest VInt */
+    VInt y = n << 3;
+    VInt x = *s_p, s = x + y;
+    int c = (( x & y ) | ( (x | y) & ~s )) >> (BITS_PER_VINT-1); /* 1st carry */
+    *s_p = s; LTOH_INC(s_p);
+
+    /* adding highest VInt */
+    *s_p = s = (x = *s_p) + (y = n >> (BITS_PER_VINT - 3)) + c;
+    c = (( x & y ) | ( (x | y) & ~s )) >> (BITS_PER_VINT-1);
+
+    /* adding carry. */
+    do {
+        LTOH_INC(s_p);
+        *s_p = s = (x = *s_p) + c;
+        c = ( x & ~s ) >> (BITS_PER_VINT-1);
+    } while( s_p != s_end  &&  c != 0 );
+}
+
+/*! Hash step, - ϰ (kappa) function. [GOST R 34.11-94, section 5.3, last parag]
+    \param h - [in] hash value of prev.iter., [out] hash value of this iter.
+    \param m - next block of message being hashed
+*/
+static void /* GostR3411_HashStep ? */
+HStep( I256 h, const I256 m, Gost28147SubstTable tabNo ) {
+    I256 s; /* evolving hash value */
+    int j;
+    /*      Let  H = (h4 || h3 || h2 || h1)
+            Then S = E(h4,K4) || E(h3, K3) || E(h2, K2) || E(h1, K1)
+     */
+    {
+        I256 K[4];
+        PRUint32
+#ifdef IS_LITTLE_ENDIAN
+                *s_p = (PRUint32 *)s,
+                *h_p = (PRUint32 *)h;
+#else
+                *s_p = (PRUint32 *)s + 6,
+                *h_p = (PRUint32 *)h + 6;
+#endif
+
+        GenKeys( K, h, m );
+
+        for( j = 0; ; ) {
+            Gost28147_EncryptStep( (VInt *)s_p, (const VInt *)h_p, K[ j ],
+                tabNo );
+            if( ++j == 4 ) break; /* X_p shall not go above X[0] */
+            s_p += (LTOH_DIR << 1);
+            h_p += (LTOH_DIR << 1);
+        }
+    }
+    /* ϰ(M,H) = ψ**61( H ^ ψ( M ^ ψ**12(S) )) */
+    I256_assign( h,
+        psi( I256_xor( s, h, psi( I256_xor( s, m, psi( s, 12 )), 1 )), 61 )
+    );
+} /* HStep */
+
+/* -------------------------------------------------------------------------
+    blapi.h (freebl) interface implementation
+ -------------------------------------------------------------------------- */
+
+struct GOSTR3411ContextStr {
+    I256    H,  /*!< latest hash value */
+            S,  /*!< checksum */
+            L;  /*!< number of hashed bits */
+    unsigned char
+            inBuf[ BYTES_PER_I256 ];
+    Gost28147SubstTable tabNo;
+};
+
+typedef struct GOSTR3411ContextStr  GOSTR3411Context;
+
+unsigned int
+GostR3411_FlattenSizeImp( GOSTR3411Context *cx ) {
+    return sizeof(GOSTR3411Context);
+}
+
+void
+GostR3411_BeginImp( GOSTR3411Context *cx ) {
+    if( cx ) {
+        I256_zero( cx->H );
+        I256_zero( cx->S );
+        I256_zero( cx->L );
+    }
+}
+
+void
+GostR3411_ClearImp( GOSTR3411Context *cx ) {
+    GostR3411_BeginImp( cx );
+    cx->tabNo = gost28147Tab_Invalid;
+}
+
+void
+GostR3411_UpdateImp( GOSTR3411Context *cx, const unsigned char *input,
+    unsigned int inputLen )
+{
+    unsigned bufLen = /* #hashed_bytes % block_size */
+        ((cx->L)[ I256_VINT_IDX(0) ] >> 3) & 31;
+    unsigned needForFullBlock = BYTES_PER_I256 - bufLen;
+
+    /*  Hmm... Am I called with damaged context ? Can't signal error, give up */
+    if( cx->tabNo >= gost28147Tab_Invalid )
+        return;
+
+    I256_add8n( cx->L, inputLen );
+
+    /* block not filled yet */
+    if( inputLen < needForFullBlock ) {
+        memcpy( cx->inBuf + bufLen, input, inputLen );
+    } else {
+        I256 B; /* nxt blk */
+        /* old remainder in a buffer */
+        if( bufLen ) {
+            memcpy( cx->inBuf + bufLen, input, needForFullBlock );
+            inputLen -= needForFullBlock;
+            input    += needForFullBlock;
+
+            I256_loadLeBytes( B, cx->inBuf );
+            I256_add( cx->S, B );
+            HStep   ( cx->H, B, cx->tabNo );
+        }
+        /* full blocks */
+        while( inputLen >= BYTES_PER_I256 )
+        {
+            I256_loadLeBytes( B, input );
+            inputLen -= BYTES_PER_I256;
+            input    += BYTES_PER_I256;
+
+            I256_add( cx->S, B );
+            HStep   ( cx->H, B, cx->tabNo );
+        }
+        /* block remainder */
+        if( inputLen )
+            memcpy( cx->inBuf, input, inputLen );
+    } /* there are blocks */
+} /* GostR3411_UpdateImp */
+
+void
+GostR3411_EndImp( GOSTR3411Context *cx, unsigned char *digest,
+    unsigned int *digestLen, unsigned int maxDigestLen )
+{
+    unsigned bufLen = /* #hashed_bytes % block_size */
+        ((cx->L)[ I256_VINT_IDX(0) ] >> 3) & 31;
+
+    /*  Hmm... Am I called with damaged context ? Trying to signal error... */
+    if( cx->tabNo >= gost28147Tab_Invalid ) {
+        if (digestLen)
+            *digestLen = 0;
+        return;
+    }
+
+    /* pad remainder and hash it */
+    if( bufLen ) {
+        I256 B;
+        memset( cx->inBuf + bufLen, 0, BYTES_PER_I256 - bufLen );
+        I256_loadLeBytes( B, cx->inBuf );
+        I256_add( cx->S, B );
+        HStep   ( cx->H, B, cx->tabNo );
+    }
+    /* finalize hash */
+    HStep( cx->H, cx->L, cx->tabNo );
+    HStep( cx->H, cx->S, cx->tabNo );
+    /* copy out */
+    if( maxDigestLen >= BYTES_PER_I256 )
+        I256_storBeBytes( digest, cx->H );
+    else {
+        I256_storBeBytes( cx->inBuf, cx->H );
+        memcpy( digest, cx->inBuf, maxDigestLen );
+    }
+    if (digestLen)
+	*digestLen = BYTES_PER_I256;
+}
+
+/*  --------------------------------------------------------------------------
+    Digest parameters.
+        DER-encoded OIDs, tag-length prefix included.
+        There is no need to place this OIDs into global OID table @ secoid.c
+*/
+static const unsigned char
+  /* 1.2.643.2.2.30.1 (see RFC4357, PKCS#11 v2.30) */
+  CryptoProA[] = {0x06,0x07,0x2a,0x85,0x03,0x02,0x02,0x1e,0x02};
+  /* CryptoPro: reserved, but not defined at the moment:
+        1.2.643.2.2.30.{2,3,4}
+     Swemel JSC: some nondisclosed parameters reserved for government
+            organizations. For use in private builds.
+        1.3.6.1.4.1.31113.30.*
+  */
+
+static const struct {
+    const unsigned char     * derOid;
+    PRUint8                 derOidLen;
+    Gost28147SubstTable     tabNo;
+}
+    digestParams[] = {
+      { CryptoProA, sizeof(CryptoProA), gost28147Tab_gostR3411CryptoProA } /*,
+      { SwemelNIIA, sizeof(SwemelNIIA), gost28147Tab_gostR3411SwemelNIIA },*/
+    };
+
+#define DIGEST_NPARAMS (sizeof(digestParams)/sizeof(digestParams[0]))
+
+PRBool
+GostR3411_InitContextImp( struct GOSTR3411ContextStr *cx, void *param,
+    unsigned int paramLen )
+{
+    int j;
+
+    if( paramLen == 0 ) /* use default (see RFC4357) */
+        j = 0;
+    else                /* search for known OID */
+        for( j = 0; j < DIGEST_NPARAMS; ++j )
+            if( (paramLen == digestParams[j].derOidLen) &&
+                    (0 == memcmp( param, digestParams[j].derOid, paramLen )) 
+            )
+                break;
+
+    if( j == DIGEST_NPARAMS )
+        return PR_FALSE;
+
+    cx->tabNo = digestParams[j].tabNo;
+    GostR3411_BeginImp( cx );
+    return PR_TRUE;
+}
