+/* $Id$ */
+/* \file
+    blapi.h (freebl) interface to GOST R 34.11-94 hash function
+
+    Hash implementation need not any NSS staff => I discourage putting NSS
+headers in. But (by NSS convention) GOSTR3411_{NewContext,Begin,...} are
+declared in blapi{,t}.h.
+
+    To stop propagation of NSS headers to hash implementation, I call it via
+GostR3411_***_Imp() redirectors. They are defined in another compilation unit
+(gost3411.c), which doesn't depend from NSS.
+*/
+
+#include "blapi.h"      /* GOSTR3411_*** declarations here */
+#include "secerr.h"
+#include "gost3411.h"
+
+unsigned int
+GOSTR3411_FlattenSize(GOSTR3411Context *cx) {
+    return GostR3411_FlattenSizeImp( cx );
+}
+
+GOSTR3411Context *
+GOSTR3411_NewContext( const SECItem *param ) {
+    GOSTR3411Context *cx = PORT_Alloc(GOSTR3411_FlattenSize(NULL));
+    if( cx ) {
+        if( ! GostR3411_InitContextImp( cx, param->data, param->len ) ) {
+            PORT_Free( cx ); cx = NULL;
+            PORT_SetError(SEC_ERROR_INVALID_ARGS);
+        }
+    }
+    return cx;
+}
+
+void
+GOSTR3411_DestroyContext(GOSTR3411Context *cx, PRBool freeit) {
+    GostR3411_ClearImp( cx ); /* better than PORT_ZFree() */
+    if( freeit )
+        PORT_Free( cx );
+}
+
+void
+GOSTR3411_Begin(GOSTR3411Context *cx) {
+    GostR3411_BeginImp( cx );
+}
+
+void
+GOSTR3411_Update( GOSTR3411Context *cx, const unsigned char *input,
+			unsigned int inputLen)
+{
+    GostR3411_UpdateImp( cx, input, inputLen );
+}
+
+void
+GOSTR3411_End(GOSTR3411Context *cx, unsigned char *digest,
+		     unsigned int *digestLen, unsigned int maxDigestLen)
+{
+    GostR3411_EndImp( cx, digest, digestLen, maxDigestLen );
+}
