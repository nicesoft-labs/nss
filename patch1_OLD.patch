+ * the terms of any one of the MPL, the GPL or the LGPL.
+ *
+ * ***** END LICENSE BLOCK ***** */
+/* $Id$ */
+/* \file
+    GOST 28147-89 algorithms (see RFC4357)
+
+    Depends only from NSPR. Do not include NSS headers.
+*/
+
+#include "gost28147-priv.h"
+
+/*! \define I64_HI32_IDX Index of high 32-bit word in a 64-bit integer. */
+/*! \define I64_LO32_IDX Index of low  32-bit word in a 64-bit integer. */
+
+#ifdef IS_LITTLE_ENDIAN
+#  define I64_HI32_IDX 1
+#  define I64_LO32_IDX 0
+#else
+#  define I64_HI32_IDX 0
+#  define I64_LO32_IDX 1
+#endif
+
+static const unsigned char * const substTables[];
+
+void
+Gost28147_EncryptStep( I64 dst, const I64 data, const I256 key,
+        Gost28147SubstTable tabNo )
+{
+    const unsigned char * const tab = substTables[ tabNo ];
+    PRUint32    /* encryption buffer */
+            hi32 = ((const PRUint32 *)data)[ I64_HI32_IDX ],
+            lo32 = ((const PRUint32 *)data)[ I64_LO32_IDX ];
+    PRUint32 f; /* round function */
+    PRUint8 j, m, n;
+
+    /* Using pointer arithm. for key schedule is disaster, because of:
+        -- if/elif/else,  -- ptr shall not go before a[0] (BE archs).
+       Let use index expression instead.
+     */
+    for( j = 0; j < 32; ++ j ) {
+        n = (m = (23 - j)) >> 5; /* j<24: =0, j>=24: =7 */
+        f = lo32 + ((const PRUint32 *)key) [
+            /* key schedule for ... */
+#ifdef IS_LITTLE_ENDIAN
+            (j & ~n & 7) | (m & n)  /* LE: 0..7 0..7 0..7 7..0 */
+#else
+            (j & n) | (m & ~n & 7)  /* BE: 7..0 7..0 7..0 0..7 */
+#endif
+        ]; /* lo32 + round key */
+
+        /*  Substitution. No loop, no addr.arith., one memory var,
+            - good chance the compiler will streamline this on registers.
+         */
+        f =
+            (0x0F & tab [      ((f      ) &0x0F) ])       |
+            (0xF0 & tab [      ((f >>  4) &0x0F) ])       |
+            (0x0F & tab [ 16 + ((f >>  8) &0x0F) ]) <<  8 |
+            (0xF0 & tab [ 16 + ((f >> 12) &0x0F) ]) <<  8 |
+            (0x0F & tab [ 32 + ((f >> 16) &0x0F) ]) << 16 |
+            (0xF0 & tab [ 32 + ((f >> 20) &0x0F) ]) << 16 |
+            (0x0F & tab [ 48 + ((f >> 24) &0x0F) ]) << 24 |
+            (0xF0 & tab [ 48 + ((f >> 28) &0x0F) ]) << 24;
+
+        f = hi32 ^ (( f<<11 )|( f>>21 )); /* rol f, 11 */
+        hi32 = lo32; lo32 = f;
+    } /* round */
+
+    /* swap last round results */
+    ((PRUint32 *)dst)[ I64_LO32_IDX ] = hi32;
+    ((PRUint32 *)dst)[ I64_HI32_IDX ] = lo32;
+} /* Gost28147_EncryptStep */
+
+/* -------------------------------------------------------------- */
+
+/* GostR3411-94-CryptoPro-A */
+static const unsigned char _gostR3411CryptoProA[64] = {
+    0x5a, 0xf4, 0x45, 0x06, 0x28, 0xd1, 0xb3, 0x97,
+    0x1d, 0x7c, 0x6e, 0x30, 0xc9, 0xe2, 0xab, 0x8f,
+    0x47, 0xaf, 0x7c, 0xce, 0x09, 0xf4, 0x21, 0x80,
+    0xe3, 0x1b, 0x65, 0x52, 0xd6, 0xba, 0x98, 0x3d,
+    0x77, 0x66, 0x24, 0x4b, 0xd9, 0x9c, 0xf2, 0x0a,
+    0xa1, 0x18, 0x50, 0xbe, 0x8f, 0xed, 0xc3, 0x35,
+    0x1d, 0x3e, 0xa4, 0x91, 0x57, 0xb0, 0x45, 0xfa,
+    0x83, 0x6c, 0x78, 0xef, 0xd6, 0x02, 0x29, 0xcb
+};
+
+static const unsigned char * const substTables[] = {
+    _gostR3411CryptoProA
+};
