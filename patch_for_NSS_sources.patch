+    if (rv == SECSuccess) { 
+        if (keyParam) {
+        	keyParam->data = gost28147.gost28147Params.data;
+        	keyParam->len = gost28147.gost28147Params.len;
+        }
+        if (ivec) {
+        	ivec->data = gost28147.iv.data;
+        	ivec->len = gost28147.iv.len;
+        }
+    }
+
