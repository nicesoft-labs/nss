+
+    slot = PK11_GetSlotFromKey(pms);
+
+    PORT_Memcpy(seed, cr, 32);
+    PORT_Memcpy(seed + 32, sr, 32);
+    rv = ssl3_TLS_PRFGOST(pms, "master secret", 13, seed, 64,
+            keyval, sizeof(keyval));
+
+    if (rv != SECSuccess) {
+        PK11_FreeSlot(slot);
+	ssl_MapLowLevelError(SSL_ERROR_SESSION_KEY_GEN_FAILURE);
+	return SECFailure;
+    }
+
+    pwSpec->master_secret = PK11_ImportSymKey(slot, CKM_GOSTR3411_HMAC,
+            PK11_OriginDerive, CKA_SIGN, &key, ss->pkcs11PinArg);
+    PORT_Memset(keyval, 0, sizeof(keyval));
+    PK11_FreeSlot(slot);
+
+    if (pwSpec->master_secret == NULL) {
+	ssl_MapLowLevelError(SSL_ERROR_SESSION_KEY_GEN_FAILURE);
+	return SECFailure;
+    }
