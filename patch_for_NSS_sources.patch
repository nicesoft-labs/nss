+    PK11_SETATTRS(&template[1], CKA_KEY_TYPE, &keyType, sizeof(keyType));
+    PK11_SETATTRS(&template[2], CKA_GOST28147PARAMS,
+            gost28147_tls_params, sizeof(gost28147_tls_params));
+
+    PK11_SETATTRS(&template[3], CKA_SIGN, &cktrue, 1);
+    PK11_SETATTRS(&template[4], CKA_VERIFY, &cktrue, 1);
