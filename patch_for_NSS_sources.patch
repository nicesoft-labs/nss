+static SECStatus
+ssl3_TLS_PRFGOST(PK11SymKey *key,
+		const char *label, unsigned int label_len,
+		const unsigned char *seed, unsigned int seed_len,
+		unsigned char *out, unsigned int out_len)
+{
+    unsigned int  len = 0;
+    unsigned char a[32];
+    unsigned int  a_len = 0;
+    unsigned char block[32];
+    unsigned int  block_len = 0;
+    SECItem       param = {siBuffer, NULL, 0};
+    SECStatus     rv = SECSuccess;
+    PK11Context *prf_context =
+        PK11_CreateContextBySymKey(CKM_GOSTR3411_HMAC, CKA_SIGN, 
+                       key, &param);
+    if (!prf_context)
+        return SECFailure;
+
+    do {
+        rv  = PK11_DigestBegin(prf_context);
+        if (len) {
+            rv |= PK11_DigestOp(prf_context, a, sizeof(a));
+        } else {
+            rv |= PK11_DigestOp(prf_context,
+	            (const unsigned char *)label, label_len);
+            rv |= PK11_DigestOp(prf_context, seed, seed_len);
+        }
+        rv |= PK11_DigestFinal(prf_context, a, &a_len, sizeof(a));
+        if (rv != SECSuccess)
+            goto end;
+        rv  = PK11_DigestBegin(prf_context);
+        rv |= PK11_DigestOp(prf_context, a, sizeof(a));
+        rv |= PK11_DigestOp(prf_context,
+	        (const unsigned char *)label, label_len);
+        rv |= PK11_DigestOp(prf_context, seed, seed_len);
+        rv |= PK11_DigestFinal(prf_context, block, &block_len, sizeof(block));
+        if (rv != SECSuccess)
+            goto end;
+        if (block_len + len > out_len)
+            block_len = out_len - len;
+        PORT_Memcpy(out + len, block, block_len);
+        len += block_len;
+    } while (len < out_len);
+
+end:
+    PK11_DestroyContext(prf_context, PR_TRUE);
+    return rv;
+}
