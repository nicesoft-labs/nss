+{
+    ssl3CipherSpec *         pwSpec     = ss->ssl3.pwSpec;
+    unsigned char *   cr     = (unsigned char *)&ss->ssl3.hs.client_random;
+    unsigned char *   sr     = (unsigned char *)&ss->ssl3.hs.server_random;
