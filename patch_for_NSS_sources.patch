+/* ===== GOST R34.10-2001 =================================================== */
+
+SECStatus
+NSS_CMSUtil_EncryptSymKey_GOSTR3410(PLArenaPool *poolp, CERTCertificate *cert, 
+                              PK11SymKey *bulkkey,
+                              SECItem *encKey)
+{
+    SECStatus rv;
+    SECKEYPublicKey *publickey;
+    int data_len;
+    KeyType keyType;
+    void *mark = NULL;
+
+    publickey = CERT_ExtractPublicKey(cert);
+    if (publickey == NULL)
+	return SECFailure;
+
+    mark = PORT_ArenaMark(poolp);
+    if (!mark)
+	goto loser;
+
+    /* sanity check */
+    keyType = SECKEY_GetPublicKeyType(publickey);
+    PORT_Assert(keyType == gostR3410Key);
+    if (keyType != gostR3410Key) {
+	goto loser;
+    }
+    /* allocate memory for the encrypted key */
+    data_len = 1024; /* should be enough */
+    encKey->data = (unsigned char*)PORT_ArenaAlloc(poolp, data_len);
+    encKey->len = data_len;
+    if (encKey->data == NULL)
+	goto loser;
+
+    /* encrypt the key now */
+    rv = PK11_PubWrapSymKey(CKM_GOSTR3410_KEY_WRAP,
+				publickey, bulkkey, encKey);
+
+    if (rv != SECSuccess)
+	goto loser;
+
+    PORT_ArenaUnmark(poolp, mark);
+    SECKEY_DestroyPublicKey(publickey);
+    return SECSuccess;
+
+loser:
+    if (mark) {
+	PORT_ArenaRelease(poolp, mark);
+    }
+    SECKEY_DestroyPublicKey(publickey);
+    return SECFailure;
+}
+
+PK11SymKey *
+NSS_CMSUtil_DecryptSymKey_GOSTR3410(SECKEYPrivateKey *privkey, SECItem *encKey,
+        SECOidTag bulkalgtag, SECItem *keyParam)
+{
+    CK_MECHANISM_TYPE target;
+    CK_ATTRIBUTE keyAttr;
+
+    PORT_Assert(bulkalgtag != SEC_OID_UNKNOWN);
+
+    target = PK11_AlgtagToMechanism(bulkalgtag);
+    if (bulkalgtag != SEC_OID_GOST28147 || target != CKM_GOST28147) {
+	PORT_SetError(SEC_ERROR_INVALID_ALGORITHM);
+	return NULL;
+    }
+
+    keyAttr.type = CKA_GOST28147PARAMS;
+    keyAttr.pValue = keyParam->data;
+    keyAttr.ulValueLen = keyParam->len;
+
+    return PK11_PubUnwrapSymKeyWithTemplate(privkey, encKey, target,
+            CKA_DECRYPT, 0, &keyAttr, 1);
+}
+
