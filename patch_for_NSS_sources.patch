+	mechanism_array[0] = CKM_GENERIC_SECRET_KEY_GEN;
+	mechanism_array[1] = CKM_GOSTR3410_KEY_WRAP;
+	mechanism_array[2] = alg2Mech[calg].cmech;
+
+	slot = PK11_GetBestSlotMultiple(mechanism_array, 3, pwArg);
